{
  "name": "plant-schedule",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "oxlint && eslint \"src/**/*.svelte\"",
    "lint:fix": "oxlint --fix && eslint \"src/**/*.svelte\" --fix",
    "format": "oxfmt && prettier --write \"src/**/*.svelte\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.svelte\"",
    "validate:plants": "tsx scripts/validate-plants.ts",
    "knip": "knip",
    "size": "size-limit",
    "prepare": "svelte-kit sync || true; lefthook install || true"
  },
  "size-limit": [
    {
      "name": "App shell (HTML + entry JS + CSS)",
      "path": [
        "build/index.html",
        "build/_app/immutable/entry/*.js",
        "build/_app/immutable/assets/*.css"
      ],
      "limit": "120 KB",
      "gzip": true
    },
    {
      "name": "All JS chunks (precached)",
      "path": ["build/_app/immutable/chunks/*.js", "build/_app/immutable/nodes/*.js"],
      "limit": "180 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@size-limit/file": "^12.1.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-svelte": "^3.0.0",
    "knip": "^6.14.1",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^3.3.0",
    "size-limit": "^12.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
