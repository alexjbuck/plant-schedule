{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "none",
  "semi": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    ".svelte-kit/**",
    "build/**",
    "node_modules/**",
    "coverage/**",
    "**/*.svelte"
  ]
}
